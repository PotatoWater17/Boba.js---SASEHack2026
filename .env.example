DATABASE_URL="file:./dev.db"
# Required in production — used to sign session cookies
SESSION_SECRET="generate-a-long-random-string"
# Vercel production uses Neon Postgres (set in the Vercel project, not git).
# DATABASE_URL="postgresql://..."
# DATABASE_URL_UNPOOLED="postgresql://..."
# Cloudflare Workers uses D1 (see wrangler.jsonc). Set SESSION_SECRET with:
#   npx wrangler secret put SESSION_SECRET
