generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  accountNo  Int?      @unique
  email      String    @unique
  password   String
  firstName  String
  lastName   String
  pronouns   String    @default("")
  year       String    @default("")
  major      String    @default("")
  university String    @default("")
  bio        String    @default("")
  photoKey   String    @default("")
  needHelp   String    @default("")
  canHelp    String    @default("")
  /// Primary course for upcoming exam prep (optional)
  examCourse String    @default("")
  examDate   String    @default("")
  examTopics String    @default("")
  /// Preferred meetup style for exam prep, e.g. Exam review
  studyStyle String    @default("")
  isAdmin         Boolean   @default(false)
  showEmail       Boolean   @default(false)
  sessionVersion  Int       @default(0)
  createdAt       DateTime  @default(now())
  members    Member[]
  messages   Message[]
  meetings   Meeting[] @relation("Host")
  friendsFrom Friendship[] @relation("FriendsFrom")
  friendsTo   Friendship[] @relation("FriendsTo")
  dmsFrom     DirectMessage[] @relation("DmFrom")
  dmsTo       DirectMessage[] @relation("DmTo")
  invitesFrom MeetupInvite[] @relation("InviteFrom")
  invitesTo   MeetupInvite[] @relation("InviteTo")
  joinRequests MeetingJoinRequest[]
  dmReactions DmReaction[]
  messageReactions MessageReaction[]
  reactionNotices ReactionNotice[] @relation("NoticeTo")
  reactionActs    ReactionNotice[] @relation("NoticeFrom")
  groupActivity   GroupActivityNotice[]
  passwordResets  PasswordResetRequest[]
  blocksGiven     Block[] @relation("BlocksGiven")
  blocksReceived  Block[] @relation("BlocksReceived")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model PasswordResetRequest {
  id           String    @id @default(cuid())
  userId       String
  note         String    @default("")
  /// pending | completed | dismissed
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String    @default("")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Meeting {
  id         String    @id @default(cuid())
  subject    String
  topic      String
  time       String
  meetDate   String    @default("")
  location   String
  isOnline   Boolean   @default(false)
  university String    @default("")
  notes      String    @default("")
  maxSize    Int       @default(8)
  /// partner | small | big
  groupKind  String    @default("small")
  /// e.g. Practice problems, Lecture / teach-back
  style            String    @default("Practice problems")
  isPrivate        Boolean   @default(false)
  requireApproval  Boolean   @default(false)
  hostId           String
  createdAt        DateTime  @default(now())
  host             User      @relation("Host", fields: [hostId], references: [id], onDelete: Cascade)
  members          Member[]
  messages         Message[]
  invites          MeetupInvite[]
  joinRequests     MeetingJoinRequest[]
}

model MeetingJoinRequest {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  /// pending | declined
  status    String   @default("pending")
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model Member {
  id         String    @id @default(cuid())
  meetingId  String
  userId     String
  lastReadAt DateTime  @default(now())
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model Friendship {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  /// pending | accepted
  status    String   @default("pending")
  createdAt DateTime @default(now())
  from      User     @relation("FriendsFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendsTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model MeetupInvite {
  id        String   @id @default(cuid())
  meetingId String
  fromId    String
  toId      String
  /// pending | accepted | declined
  status    String   @default("pending")
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  from      User     @relation("InviteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("InviteTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([meetingId, toId])
}

model Message {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  text      String   @default("")
  fileName  String   @default("")
  fileKey   String   @default("")
  fileMime  String   @default("")
  unsent         Boolean  @default(false)
  /// Set when the owner removes this member — chat shows "Removed user" instead of their name.
  authorRemoved  Boolean  @default(false)
  createdAt      DateTime @default(now())
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions      MessageReaction[]
}

model DirectMessage {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  text      String   @default("")
  fileName  String   @default("")
  fileKey   String   @default("")
  fileMime  String   @default("")
  inviteId  String   @default("")
  seen      Boolean  @default(true)
  unsent    Boolean  @default(false)
  createdAt DateTime @default(now())
  from      User     @relation("DmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("DmTo", fields: [toId], references: [id], onDelete: Cascade)
  reactions DmReaction[]
}

model DmReaction {
  id        String        @id @default(cuid())
  dmId      String
  userId    String
  emoji     String
  createdAt DateTime      @default(now())
  dm        DirectMessage @relation(fields: [dmId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dmId, userId, emoji])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model ReactionNotice {
  id        String   @id @default(cuid())
  userId    String
  actorId   String
  emoji     String
  dmId      String   @default("")
  messageId String   @default("")
  meetingId String   @default("")
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("NoticeTo", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("NoticeFrom", fields: [actorId], references: [id], onDelete: Cascade)
}

/// Durable bell notice when someone leaves, is kicked, or a group is disbanded.
/// Snapshots names because the meeting row may already be gone.
model GroupActivityNotice {
  id         String   @id @default(cuid())
  userId     String
  /// leave | kicked | disbanded
  kind       String
  meetingId  String   @default("")
  subject    String
  actorId    String   @default("")
  actorName  String   @default("")
  actorPhoto String   @default("")
  seen       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seen, createdAt])
}
