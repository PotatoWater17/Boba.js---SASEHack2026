generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  firstName  String
  lastName   String
  pronouns   String    @default("")
  year       String    @default("")
  major      String    @default("")
  university String    @default("")
  bio        String    @default("")
  needHelp   String    @default("")
  canHelp    String    @default("")
  createdAt  DateTime  @default(now())
  members    Member[]
  messages   Message[]
  meetings   Meeting[] @relation("Host")
  friendsFrom Friendship[] @relation("FriendsFrom")
  friendsTo   Friendship[] @relation("FriendsTo")
  dmsFrom     DirectMessage[] @relation("DmFrom")
  dmsTo       DirectMessage[] @relation("DmTo")
}

model Meeting {
  id         String    @id @default(cuid())
  subject    String
  topic      String
  time       String
  meetDate   String    @default("")
  location   String
  university String    @default("")
  notes      String    @default("")
  maxSize    Int       @default(8)
  /// partner | small | big
  groupKind  String    @default("small")
  /// e.g. Practice problems, Lecture / teach-back
  style      String    @default("Practice problems")
  hostId     String
  createdAt  DateTime  @default(now())
  host       User      @relation("Host", fields: [hostId], references: [id])
  members    Member[]
  messages   Message[]
}

model Member {
  id        String  @id @default(cuid())
  meetingId String
  userId    String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model Friendship {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  /// pending | accepted
  status    String   @default("pending")
  createdAt DateTime @default(now())
  from      User     @relation("FriendsFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendsTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model Message {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  text      String
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DirectMessage {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  text      String   @default("")
  fileName  String   @default("")
  fileKey   String   @default("")
  fileMime  String   @default("")
  createdAt DateTime @default(now())
  from      User     @relation("DmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("DmTo", fields: [toId], references: [id], onDelete: Cascade)
}
