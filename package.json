{
  "name": "studybuddyboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-vercel.mjs && prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:restore-team": "tsx scripts/restore-team.ts",
    "db:backup-accounts": "tsx scripts/backup-accounts.ts",
    "db:restore-accounts": "tsx scripts/restore-accounts-backup.ts",
    "db:patch-demo": "tsx scripts/patch-demo-world.ts",
    "db:refresh-avatars": "tsx scripts/refresh-avatars.ts",
    "db:ryan-friends": "tsx scripts/seed-ryan-friends.ts",
    "db:meme-meetups": "tsx scripts/seed-meme-meetups.ts",
    "db:backfill-online": "tsx scripts/backfill-meeting-online.ts",
    "db:demo-full": "npm run db:reset && npm run db:ryan-friends && npm run db:restore-accounts && npm run db:backfill-online",
    "logo:export": "node scripts/export-logo.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:seed": "wrangler d1 execute studybuddyboard --remote --file=migrations/0002_demo_data.sql",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "pw": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/potatowater.ps1",
    "pw:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/potatowater.ps1 status",
    "pw:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/potatowater.ps1 start",
    "pw:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/potatowater.ps1 stop",
    "pw:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/potatowater.ps1 restart",
    "pw:stop:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/potatowater.ps1 stop -Tunnel",
    "pw:restart:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/potatowater.ps1 restart -Tunnel"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.135.0"
  }
}
